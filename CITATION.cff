license: MIT
repository-code: "https://github.com/andrebadini/buscateses-local"
url: "https://github.com/andrebadini/buscateses-local"
keywords:
  - teses
  - dissertações
  - CAPES
  - busca semântica
  - MCP
  - pesquisa acadêmica
  - acessibilidade
